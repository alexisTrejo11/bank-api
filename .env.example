# Copy to `.env` (`cp .env.example .env`) and fill every value — no defaults in YAML/Compose.
# Validate before deploy:
#   ./docker/validate-env.sh app
#   ./docker/validate-env.sh local
#
# Spring Boot loads this file via DotEnvEnvironmentPostProcessor (lowest precedence).
# Docker Compose also reads `.env` for variable substitution.
# Quote values that contain & or spaces: SPRING_DATASOURCE_URL="jdbc:...?ssl=true&..."

# =============================================================================
# APP — read by Spring (application.yaml + application-docker.yaml)
# Change these when moving local → AWS (RDS, ElastiCache, MSK/Kafka, etc.)
# =============================================================================

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=
SPRING_DATA_REDIS_PASSWORD=

SPRING_KAFKA_BOOTSTRAP_SERVERS=
SPRING_KAFKA_CONSUMER_GROUP_ID=

# Path(s) that Spring exposes for monitoring (NOT Grafana URL — see docker/MONITORING.md)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=

BANK_KAFKA_ENABLED=
# When BANK_KAFKA_ENABLED=true (e.g. docker/compose.local.yml): set to kafka
BANK_NOTIFICATIONS_DISPATCH_MODE=

# --- Logging / observability (see docs/OBSERVABILITY.md) ---
BANK_LOGGING_DIRECTORY=logs
BANK_LOGGING_MAX_FILE_SIZE_MB=50
BANK_LOGGING_MAX_HISTORY_DAYS=14
BANK_LOGGING_TOTAL_SIZE_CAP_MB=500
BANK_LOGGING_ACCESS_ENABLED=true
BANK_LOGGING_SQL_DEBUG=false
BANK_LOGGING_LOKI_ENABLED=false
LOKI_URL=
BANK_LOGGING_LOGSTASH_ENABLED=false
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
# Local compose.local.yml defaults:
# BANK_LOGGING_LOKI_ENABLED=true
# LOKI_URL=http://loki:3100/loki/api/v1/push
# GRAFANA_LOKI_URL=http://loki:3100
# LOKI_PORT=3100

# --- Local example ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/at_bank
# SPRING_DATA_REDIS_HOST=redis
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# BANK_KAFKA_ENABLED=true
# BANK_NOTIFICATIONS_DISPATCH_MODE=kafka
#
# --- AWS example ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds.region.rds.amazonaws.com:5432/at_bank
# SPRING_DATA_REDIS_HOST=your-elasticache.xxxxx.cache.amazonaws.com
# SPRING_KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092

# =============================================================================
# DOCKER APP — read by docker/compose.yml (deploy / EC2 app container only)
# =============================================================================

APP_HTTP_PORT=
BANK_API_IMAGE_TAG=

# =============================================================================
# MONITORING — NOT read by Spring
# Read by Prometheus/Grafana containers via docker/infra/*.template + compose.local.yml
# Only required for: docker compose -f docker/compose.local.yml
# On AWS: set these on the EC2 where Prometheus/Grafana run (or your Prometheus config)
# =============================================================================

PROMETHEUS_SCRAPE_TARGET=
PROMETHEUS_METRICS_PATH=
GRAFANA_PROMETHEUS_URL=
PROMETHEUS_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Local (Docker network hostnames) ---
# PROMETHEUS_SCRAPE_TARGET=app:8080
# PROMETHEUS_METRICS_PATH=/actuator/prometheus
# GRAFANA_PROMETHEUS_URL=http://prometheus:9090
#
# --- AWS (private IP or DNS of your app / Prometheus EC2) ---
# PROMETHEUS_SCRAPE_TARGET=10.0.1.20:8080
# PROMETHEUS_METRICS_PATH=/actuator/prometheus
# GRAFANA_PROMETHEUS_URL=http://10.0.1.21:9090

# =============================================================================
# LOCAL STACK ONLY — docker/compose.local.yml (postgres container + nginx)
# =============================================================================

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
NGINX_HTTP_PORT=

# --- JWT (optional until you enable signed JWT in prod) ---
# BANK_SECURITY_JWT_PRIVATE_KEY_PEM=
# BANK_SECURITY_JWT_PUBLIC_KEY_PEM=

# --- Optional domain toggles ---
# BANK_LOANS_INTERNAL_FUNDING_ACCOUNT_ID=
# BANK_NOTIFICATIONS_DEV_REDIRECT_EMAIL=
# BANK_NOTIFICATIONS_STUB_SMS_E164=
# BANK_NOTIFICATIONS_KAFKA_DISPATCH_TOPIC=
# BANK_NOTIFICATIONS_KAFKA_PIPELINE_TOPIC=
